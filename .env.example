# Local Postgres (use one connection string for both vars)
DATABASE_URL="postgresql://user:password@localhost:5432/email_tracking?schema=public"
DATABASE_POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/email_tracking?schema=public"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/email_tracking?schema=public"

# --- Dashboard accounts ------------------------------------------------------
# One variable per user. The user registry in src/config/users.ts maps each
# email address to the variable holding its password. A user whose variable is
# unset simply cannot sign in.
#
# Never commit real passwords. Set these in Vercel → Settings → Environment
# Variables, then redeploy.

# michael@fusionagency.solutions — administrator
ADMIN_PASSWORD="change-me-to-a-strong-password"

# steven@fusionagency.solutions — email build
STEVEN_PASSWORD="change-me-to-a-strong-password"

# --- Privacy -----------------------------------------------------------------
# Secret used to HMAC-hash client IPs before storage (generate with:
# openssl rand -hex 32). Must stay stable or historical hashes stop matching.
IP_HASH_SECRET="change-me-to-a-random-secret"
