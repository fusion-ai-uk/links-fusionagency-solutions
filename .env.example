# Local Postgres (use one connection string for both vars)
DATABASE_URL="postgresql://user:password@localhost:5432/email_tracking?schema=public"
DATABASE_POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/email_tracking?schema=public"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/email_tracking?schema=public"

# Password for /admin dashboard login
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret used to HMAC-hash client IPs before storage (generate with: openssl rand -hex 32)
IP_HASH_SECRET="change-me-to-a-random-secret"
