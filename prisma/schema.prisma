generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel Neon sets both DATABASE_URL and DATABASE_POSTGRES_PRISMA_URL.
  // Prisma on serverless needs the pooled Prisma URL; migrations use directUrl.
  url       = env("DATABASE_POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model EmailEvent {
  id             String   @id @default(cuid())
  eventType      String   @map("event_type")
  campaignId     String?  @map("campaign_id")
  recipientToken String?  @map("recipient_token")
  messageId      String?  @map("message_id")
  linkId         String?  @map("link_id")
  destinationUrl String?  @map("destination_url")
  ipHash         String?  @map("ip_hash")
  ipCountry      String?  @map("ip_country")
  ipRegion       String?  @map("ip_region")
  ipCity         String?  @map("ip_city")
  userAgent      String?  @map("user_agent") @db.Text
  isBot          Boolean  @default(false) @map("is_bot")
  /// Which bot/scanner pattern matched, when isBot is true.
  botReason      String?  @map("bot_reason")
  createdAt      DateTime @default(now()) @map("created_at")

  // Request hints captured from Sep 2026. Real browser navigations send the
  // Sec-Fetch-* headers; programmatic fetchers (link scanners, previewers)
  // mostly do not. NULL on rows recorded before these were captured.
  acceptLanguage String?  @map("accept_language")
  acceptHeader   String?  @map("accept_header") @db.Text
  secFetchMode   String?  @map("sec_fetch_mode")
  secFetchDest   String?  @map("sec_fetch_dest")
  secFetchUser   String?  @map("sec_fetch_user")
  secFetchSite   String?  @map("sec_fetch_site")
  /// Derived at write time: navigation | image | other | none.
  clientKind     String?  @map("client_kind")

  @@index([eventType])
  @@index([campaignId])
  @@index([recipientToken])
  @@index([linkId])
  @@index([createdAt])
  // For clustering near-simultaneous clicks on the same link.
  @@index([campaignId, linkId, createdAt])
  @@map("email_events")
}

/// Sign-in attempts, kept briefly so repeated guessing can be slowed down
/// across serverless instances. Rows older than the window are irrelevant and
/// are pruned opportunistically.
model LoginAttempt {
  id          String   @id @default(cuid())
  /// "email:<lower-cased address>" or "ip:<hashed ip>"
  key         String
  success     Boolean
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([key, attemptedAt])
  @@map("login_attempts")
}
